{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrismFlow",
  "version": "0.1.0",
  "identifier": "app.prismflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "PrismFlow", "width": 1100, "height": 720, "minWidth": 880, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
